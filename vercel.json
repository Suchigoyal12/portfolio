{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/about", "destination": "/index.html" },
    { "source": "/work", "destination": "/index.html" },
    { "source": "/work/check-access", "destination": "/index.html" },
    { "source": "/work/check-access/full", "destination": "/index.html" },
    { "source": "/work/ai-trust-layer", "destination": "/index.html" },
    { "source": "/work/admin-shell", "destination": "/index.html" },
    { "source": "/work/release-notes", "destination": "/index.html" }
  ]
}
